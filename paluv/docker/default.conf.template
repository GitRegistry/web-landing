log_format api '$remote_addr - $request_method $request_uri '
               'status=$status upstream=$upstream_status '
               'rt=$request_time urt=$upstream_response_time '
               'cl=$content_length';

map $http_origin $allowed_origin {
  default 0;
  "https://paluv.de" 1;
  "https://www.paluv.de" 1;
}

map $http_accept_language $preferred_lang {
  default en;
  ~*de de;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  error_log /dev/stderr info;

  location = /send {
    if ($request_method != "POST") { return 405; }
    if ($allowed_origin = 0) { return 403; }
    access_log /dev/stdout api;
    proxy_pass https://mailer.misei.dev/send;
    proxy_ssl_server_name on;
    proxy_set_header Host mailer.misei.dev;
    proxy_set_header X-API-Key ${MESSAGE_API_KEY};
    proxy_set_header Content-Type $content_type;
    proxy_set_header Content-Length $content_length;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = / {
    return 302 /$preferred_lang/;
  }

  location = /index.html {
    return 302 /$preferred_lang/;
  }

  location = /en {
    return 302 /en/;
  }

  location = /de {
    return 302 /de/;
  }

  location = /de/impressum {
    return 302 /de/impressum/;
  }

  location = /de/datenschutz {
    return 302 /de/datenschutz/;
  }

  location ^~ /en/ {
    try_files $uri $uri/ /en/index.html;
  }

  location ^~ /de/ {
    try_files $uri $uri/ /de/index.html;
  }

  location / {
    try_files $uri $uri/ =404;
  }
}
